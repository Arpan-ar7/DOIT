{
  "expo": {
    "name": "UniCart",
    "slug": "unicart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Unicart_logo.jpg",
    "scheme": "unicart",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Unicart_logo.jpg"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Unicart_logo.jpg",
        "backgroundImage": "./assets/images/Unicart_logo.jpg",
        "monochromeImage": "./assets/images/Unicart_logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hex2.unicart",
      "googleServicesFile": "./google-services.json",
      "ndkVersion": "26.1.10909125"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5ccf545-51e6-49ef-910a-2189c3d35d42"
      }
    }
  }
}